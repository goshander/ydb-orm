{
  "name": "ydb-orm",
  "description": "YDB simple ORM implementation",
  "author": {
    "name": "Georgy Malkov",
    "email": "i@malkovgv.ru",
    "url": "https://github.com/goshander/ydb-orm"
  },
  "homepage": "https://github.com/goshander/ydb-orm",
  "repository": {
    "url": "https://github.com/goshander/ydb-orm"
  },
  "license": "see in LICENSE",
  "version": "3.0.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test-debug": "tap --ts -O -T --node-arg=--inspect-brk --bail --jobs=1 --reporter=list --no-coverage test/**/*.spec.ts",
    "test": "bun test --bail --timeout=30000 ./test/*.spec.ts",
    "test:unit": "bun test --bail --timeout=30000 ./test/unit.spec.ts",
    "test:coverage": "bun test --bail --timeout=30000 ./test/*.spec.ts --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:nodejs": "rm -rf ./dist && tsc -p tsconfig.json && node --test test/nodejs.test.spec.js",
    "test:smoke": "node scripts/smoke.mjs",
    "test:cloud": "./scripts/cloud.sh",
    "test:docker": "docker compose --env-file .env.test build test && docker compose --env-file .env.test run --rm test",
    "test:docker:nodejs": "docker compose --env-file .env.test run --build --rm test-nodejs",
    "test:docker:smoke": "docker compose --env-file .env.test run --build --rm test-smoke",
    "test:docker:clean": "docker compose --env-file .env.test down -v --rmi local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build": "rm -rf ./dist && tsc -p tsconfig.json",
    "build:test": "rm -rf ./dist && tsc -p tsconfig.test.json",
    "docker:db-up": "docker compose -f docker-compose.db.yaml up -d database",
    "docker:db-down": "docker compose -f docker-compose.db.yaml down database",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@ydbjs/api": "^6.0.7",
    "@ydbjs/auth": "^6.3.1",
    "@ydbjs/core": "^6.3.1",
    "@ydbjs/error": "^6.0.6",
    "@ydbjs/query": "^6.3.0",
    "@ydbjs/retry": "^6.3.0",
    "@ydbjs/value": "^6.0.8",
    "jose": "^6.2.0",
    "pino": "^10.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@types/long": "^5.0.0",
    "long": "^5.3.2",
    "nanoid": "^5.1.16",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  }
}
